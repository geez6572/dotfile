# Homebrew
if [[ "$OSTYPE" == darwin* ]]; then

    # 设置 Homebrew 镜像环境变量
    function set_homebrew_env() {
        export HOMEBREW_API_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api"
        export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"
        export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git"
        export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/homebrew-core.git"
        export HOMEBREW_PIP_INDEX_URL="https://pypi.tuna.tsinghua.edu.cn/simple"
    }

    # 切换到国内镜像
    function set_homebrew_mirror() {
        set_homebrew_env

        for tap in core cask{,-fonts,-versions} command-not-found services; do
            brew tap --custom-remote --force-auto-update "homebrew/${tap}" \
                "https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/homebrew-${tap}.git"
        done

        brew update
    }

    # 重置环境变量
    function reset_homebrew_env() {
        unset HOMEBREW_API_DOMAIN
        unset HOMEBREW_BOTTLE_DOMAIN
        unset HOMEBREW_BREW_GIT_REMOTE
        unset HOMEBREW_CORE_GIT_REMOTE
        unset HOMEBREW_PIP_INDEX_URL
    }

    # 重置到官方源
    function reset_homebrew_mirror() {
        reset_homebrew_env

        git -C "$(brew --repo)" remote set-url origin https://github.com/Homebrew/brew

        for tap in core cask{,-fonts,-versions} command-not-found services; do
            brew tap --custom-remote "homebrew/${tap}" "https://github.com/Homebrew/homebrew-${tap}"
        done

        brew update
    }

    # 可选：启动默认不自动设置镜像，手动调用 set_homebrew_mirror
   # reset_homebrew_env

    # Apple Silicon 检测

fi


