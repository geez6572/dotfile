# Local configurations -*- mode: sh -*-

# Theme
if (( $+commands[starship] )); then
    _SS_DIR="$HOME/.config/starship"
    _SS_LAYOUT_DIR="$_SS_DIR/layouts"
    _SS_COLOR_DIR="$_SS_DIR/colors"
    _SS_LAYOUT_FILE="$_SS_DIR/.current-layout"
    _SS_COLOR_FILE="$_SS_DIR/.current-colors"
    _SS_ACTIVE="$_SS_DIR/active.toml"
    _SS_DEFAULT_LAYOUT="split"
    _SS_DEFAULT_COLOR="tokyo-night"

    _ss_read() { [[ -f "$1" ]] && cat "$1" || echo "$2"; }

    _ss_build() {
        local color="$1"
        local lf="$_SS_LAYOUT_DIR/${_SS_DEFAULT_LAYOUT}.toml"
        local cf="$_SS_COLOR_DIR/${color}.toml"
        if [[ ! -f "$lf" ]]; then echo "Layout not found: $_SS_DEFAULT_LAYOUT"; return 1; fi
        if [[ ! -f "$cf" ]]; then echo "Color not found: $color"; return 1; fi
        cat "$lf" "$cf" > "$_SS_ACTIVE"
    }

    _ss_color="$(_ss_read "$_SS_COLOR_FILE" "$_SS_DEFAULT_COLOR")"

    if _ss_build "$_ss_color" 2>/dev/null; then
        export STARSHIP_CONFIG="$_SS_ACTIVE"
    fi

    eval "$(starship init zsh)"

    function sst() {
        local color
        _ss_color="$(_ss_read "$_SS_COLOR_FILE" "$_SS_DEFAULT_COLOR")"

        case "$1" in
            -l)
                echo "Colors (current: $_ss_color):"
                for f in "$_SS_COLOR_DIR"/*.toml; do
                    local n="$(basename "$f" .toml)"
                    [[ "$n" == "$_ss_color" ]] && echo "  * $n" || echo "    $n"
                done
                return 0
                ;;
            -C)
                if [[ -z "$2" ]]; then
                    if (( $+commands[fzf] )); then
                        color="$(ls "$_SS_COLOR_DIR"/*.toml | xargs -n1 basename | sed 's/\.toml$//' | fzf --prompt='color> ' --height=~40% --layout=reverse --preview="cat $_SS_COLOR_DIR/{}.toml")"
                    else
                        echo "Usage: sst -C <color_name>"; return 1
                    fi
                else
                    color="$2"
                fi
                [[ -z "$color" ]] && return 0
                if [[ ! -f "$_SS_COLOR_DIR/${color}.toml" ]]; then
                    echo "Color not found: $color"; return 1
                fi
                echo "$color" > "$_SS_COLOR_FILE"
                _ss_build "$color" || return 1
                export STARSHIP_CONFIG="$_SS_ACTIVE"
                echo "Color: $color"
                ;;
            -r)
                echo "$_SS_DEFAULT_COLOR" > "$_SS_COLOR_FILE"
                _ss_build "$_SS_DEFAULT_COLOR" || return 1
                export STARSHIP_CONFIG="$_SS_ACTIVE"
                echo "Reset to: $_SS_DEFAULT_COLOR"
                ;;
            "")
                if (( ! $+commands[fzf] )); then
                    echo "Usage: sst <color>        Switch color"
                    echo "       sst                Interactive (requires fzf)"
                    echo "       sst -l             List colors"
                    echo "       sst -C <color>     Switch color"
                    echo "       sst -r             Reset to default"
                    return 1
                fi
                color="$(ls "$_SS_COLOR_DIR"/*.toml | xargs -n1 basename | sed 's/\.toml$//' | fzf --prompt='color> ' --height=~40% --layout=reverse --preview="cat $_SS_COLOR_DIR/{}.toml")"
                [[ -z "$color" ]] && return 0
                echo "$color" > "$_SS_COLOR_FILE"
                _ss_build "$color" || return 1
                export STARSHIP_CONFIG="$_SS_ACTIVE"
                echo "Color: $color"
                ;;
            *)
                color="$1"
                if [[ ! -f "$_SS_COLOR_DIR/${color}.toml" ]]; then
                    echo "Color not found: $color"; return 1
                fi
                echo "$color" > "$_SS_COLOR_FILE"
                _ss_build "$color" || return 1
                export STARSHIP_CONFIG="$_SS_ACTIVE"
                echo "Color: $color"
                ;;
        esac
    }
else
    zinit ice depth"1" pick"async.zsh" src"pure.zsh"
    zinit light sindresorhus/pure
fi

