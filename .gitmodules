[submodule "tmux/plugins/tpm"]
	url = https://github.com/tmux-plugins/tpm
	path = tmux/plugins/tpm
[submodule "tmux/plugins/catppuccin/tmux"]
	url = https://github.com/catppuccin/tmux
	path = tmux/plugins/catppuccin/tmux
[submodule "tmux/plugins/tmux-battery"]
	url = https://github.com/tmux-plugins/tmux-battery
	path = tmux/plugins/tmux-battery
[submodule "tmux/plugins/tmux-cpu"]
	url = https://github.com/tmux-plugins/tmux-cpu
	path = tmux/plugins/tmux-cpu
[submodule "tmux/plugins/tmux-nerd-font-window-name"]
	url = https://github.com/joshmedeski/tmux-nerd-font-window-name
	path = tmux/plugins/tmux-nerd-font-window-name
[submodule "tmux/plugins/tmux-sessionx"]
	url = https://github.com/omerxx/tmux-sessionx
	path = tmux/plugins/tmux-sessionx
[submodule "tmux/plugins/tmux-yank"]
	url = https://github.com/tmux-plugins/tmux-yank
	path = tmux/plugins/tmux-yank
[submodule "nvim"]
	path = nvim
	url = git@github.com:geez6572/nvim.git
[submodule "emacs"]
	path = emacs
	url = git@github.com:geez6572/emacs.git
